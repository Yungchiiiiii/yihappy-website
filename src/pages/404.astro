---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import { pageMeta } from '../data/pages';
import { ui } from '../data/ui';

// 404（§5.7）：noindex；GitHub Pages 會以 dist/404.html 回應找不到的路徑
---

<Base title={pageMeta.notFound.title} description={pageMeta.notFound.description} noindex>
  <Section tone="paper" labelledby="not-found-title">
    <Container narrow>
      <h1 id="not-found-title" class="t-h1">{ui.notFound.title}</h1>
      <p class="not-found__text t-lede">{ui.notFound.text}</p>
      <ul class="not-found__links">
        {
          ui.notFound.links.map((link) => (
            <li>
              <Button variant="text" href={link.href} arrow>
                {link.label}
              </Button>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</Base>

<style>
  .not-found__text {
    margin-top: var(--s-4);
  }
  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-6);
  }
</style>
