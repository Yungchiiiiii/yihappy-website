---
// 內容容器：max-width 1200（narrow 760），左右 gutter（§3.3）
interface Props {
  narrow?: boolean;
  class?: string;
}
const { narrow = false, class: className } = Astro.props;
---

<div class:list={['container', { 'container--narrow': narrow }, className]}>
  <slot />
</div>

<style>
  .container {
    box-sizing: content-box;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .container--narrow {
    max-width: var(--container-narrow);
  }
</style>
