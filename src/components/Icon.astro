---
import type { IconName } from '../data/types';

// NeedCard 用的 28px 線條圖示（自繪，不用 icon library）
interface Props {
  name: IconName;
  size?: number;
}
const { name, size = 28 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 28 28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'textbook' && (
    <>
      <path d="M6 4.5h14.5A1.5 1.5 0 0 1 22 6v18H7.5A1.5 1.5 0 0 1 6 22.5z" />
      <path d="M6 20.5A1.5 1.5 0 0 1 7.5 19H22" />
      <path d="M10 9h8M10 12.5h5" />
    </>
  )}
  {name === 'book' && (
    <>
      <path d="M14 8c-2.2-1.9-5.1-2.4-9-2v15.5c3.9-.4 6.8.1 9 2 2.2-1.9 5.1-2.4 9-2V6c-3.9-.4-6.8.1-9 2z" />
      <path d="M14 8v15.5" />
    </>
  )}
  {name === 'copies' && (
    <>
      <rect x="9" y="8.5" width="14" height="15.5" rx="1.2" />
      <path d="M5.5 19V5.7A1.2 1.2 0 0 1 6.7 4.5H18" />
      <path d="M12.5 13.5h7M12.5 17h7" />
    </>
  )}
  {name === 'card' && (
    <>
      <rect x="3.5" y="6.5" width="21" height="15" rx="1.5" />
      <path d="M14 6.5v15" />
      <path d="M7 11.5h3.5M7 15h3.5" />
    </>
  )}
  {name === 'poster' && (
    <>
      <rect x="3.5" y="4" width="21" height="15" rx="1" />
      <path d="M7.5 15.5l4-5 3 3 2.5-3 3.5 5" />
      <path d="M14 19v4.5M10 23.5h8" />
    </>
  )}
  {name === 'plate' && (
    <>
      <rect x="3.5" y="5" width="21" height="18" rx="1" />
      <circle cx="14" cy="14" r="4" />
      <path d="M14 7.5v13M7.5 14h13" />
    </>
  )}
</svg>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
